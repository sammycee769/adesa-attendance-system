# Copy to .env and fill in real values. NEVER commit a filled-in .env file.

# --- Database (local development defaults shown; replace everywhere else) ---
# If port 5432 is taken on your host, change POSTGRES_PORT and DB_URL together.
POSTGRES_PORT=5432
# Required by docker-compose.yml: there is no default password, so a missing
# value is a startup error instead of a known credential.
POSTGRES_PASSWORD=adesa_dev_password
DB_URL=jdbc:postgresql://localhost:5432/adesa_attendance
DB_USERNAME=adesa_app
DB_PASSWORD=adesa_dev_password

# --- Attendance network policy ---
# Approved office egress addresses (IPv4 only) and trusted proxies are
# supplied by ADESA IT after the actual hosted request path is verified.
# Leave empty until then. Never assume a previously observed address is what
# Render sees. Do NOT add private/laptop or link-local addresses.
ATTENDANCE_ALLOWED_IPV4=
#
# Reverse proxies whose forwarding headers may be trusted. EMPTY until the
# actual hosting path, header behavior, and stable proxy peer IP are verified.
# Never add a guessed or broad proxy range.
ATTENDANCE_TRUSTED_PROXY_ADDRESSES=
#
# Enforcement stays DISABLED until the office-network check has been verified
# from inside the office (see README "Verifying the office address before
# enforcement is switched on"). In production it must be switched on explicitly
# and the 'prod' profile refuses to start while it is disabled, so it cannot be
# bypassed by accident.
ATTENDANCE_NETWORK_ENFORCEMENT_ENABLED=false
#
# Explicit LOCAL-DEVELOPMENT bypass. With enforcement disabled above, attendance
# actions FAIL CLOSED (HTTP 403) unless this is set to true. It exists only so a
# developer machine that is not on the office network can still exercise
# attendance. It is refused whenever the 'prod' profile is active, so it can
# never weaken a production deployment.
ATTENDANCE_NETWORK_LOCAL_DEVELOPMENT_BYPASS=false
# Header carrying the client address; only trusted when the direct peer is in
# ATTENDANCE_TRUSTED_PROXY_ADDRESSES.
ATTENDANCE_CLIENT_IP_HEADER=X-Forwarded-For
# Development-only restricted security log (denied attendance attempts).
# Production routes security events to stderr for platform capture.
SECURITY_LOG_FILE=logs/security.log
# Timezone that defines the attendance workday and the displayed timestamps.
ATTENDANCE_TIMEZONE=Africa/Lagos

# --- Mail (optional in local development; required with TLS/auth in prod) ---
# Use zoho-api for Render free; smtp remains the local default.
MAIL_PROVIDER=smtp
ZOHO_DATA_CENTER=
ZOHO_MAIL_ACCOUNT_ID=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_SMTP_SSL_ENABLE=false

# --- WebAuthn ---
# PLACEHOLDER: must match the deployed domain, supplied by ADESA IT.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=ADESA HQ Attendance
WEBAUTHN_ALLOWED_ORIGINS=http://localhost:5173
# Request user verification (biometric/PIN) during ceremonies. The 'prod'
# profile requires this to be true.
WEBAUTHN_USER_VERIFICATION_REQUIRED=false

# --- Server ---
SERVER_PORT=8080
# NOTE: forwarded headers are intentionally handled by the application itself
# (trusted-proxy aware), NOT by Spring's FRAMEWORK forward-headers strategy.

# --- Sessions and authentication ---
# Idle timeout (no activity) and absolute lifetime (enforced by the app).
SESSION_IDLE_TIMEOUT=30m
SESSION_ABSOLUTE_TIMEOUT=12h
# Session cookie 'Secure' flag. Must be true behind HTTPS; the 'prod' profile
# forces it to true.
SESSION_COOKIE_SECURE=false
# Failed password attempts per account **and client address** within LOGIN_WINDOW
# before HTTP 429. Keying by source address prevents an unauthenticated attacker
# from locking an account out globally.
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW=15m
# Upper bound on the login limiter's in-memory key set (memory protection).
LOGIN_MAX_TRACKED_KEYS=10000
# Single-use WebAuthn ceremony lifetimes.
WEBAUTHN_CHALLENGE_TTL=2m
DEVICE_PROOF_TTL=2m

# --- First administrator (bootstrap) ---
# Used ONLY when no ADMIN account exists yet. The account is created at startup
# and written to the audit log (FIRST_ADMIN_BOOTSTRAPPED). Unset the values
# again afterwards: the password must not be persisted anywhere, and the
# administrator has to change it after the first sign-in.
ADESA_BOOTSTRAP_ADMIN_EMPLOYEE_NUMBER=
ADESA_BOOTSTRAP_ADMIN_FULL_NAME=
ADESA_BOOTSTRAP_ADMIN_EMAIL=
ADESA_BOOTSTRAP_ADMIN_PASSWORD=

# --- Local development accounts (DEV ONLY) ---
# Read by dev.sh for the local smoke test. Never reuse these values outside a
# developer machine.
DEV_ADMIN_EMAIL=admin@adesa.test
DEV_ADMIN_PASSWORD=change-me-local-only
DEV_EMPLOYEE_EMAIL=amina.bello@adesa.test
DEV_EMPLOYEE_PASSWORD=change-me-local-only
DEV_HR_EMAIL=grace.eze@adesa.test
DEV_HR_PASSWORD=change-me-local-only
