<?xml version="1.0" encoding="UTF-8"?>
<!--
    Logging configuration.

    Two streams:
      * the application log (console, INFO) for diagnostics and operations;
      * the SECURITY log (separate file) for denied attendance attempts and
        other security events. The SECURITY logger does not propagate to the
        application log, so the resolved client address stays in the
        restricted file only.

    The security log file must be readable by the operations/IT account only
    (chmod 640, dedicated directory). Set SECURITY_LOG_FILE to move it.
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <property name="SECURITY_LOG_FILE" value="${SECURITY_LOG_FILE:-logs/security.log}"/>
    <property name="SECURITY_LOG_PATTERN"
              value="%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%thread] %logger{36} - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- Restricted security log: access must be limited to the IT account. -->
    <appender name="SECURITY_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${SECURITY_LOG_FILE}</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${SECURITY_LOG_FILE}.%d{yyyy-MM-dd}.%i.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${SECURITY_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- Security events only: never mixed into the general application log. -->
    <logger name="SECURITY" level="INFO" additivity="false">
        <appender-ref ref="SECURITY_FILE"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
